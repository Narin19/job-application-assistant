# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file — it holds credentials.
# ---------------------------------------------------------------------------

# --- Job search criteria -----------------------------------------------
JOB_TITLES=React JS,React Native,Frontend Developer,Frontend Engineer
LOCATIONS=Mumbai,Navi Mumbai,Thane
MIN_EXPERIENCE=2
MAX_EXPERIENCE=4

# --- Naukri credentials (only used for the first interactive login) ----
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
NAUKRI_ENABLED=true

# --- LinkedIn credentials -----------------------------------------------
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
LINKEDIN_ENABLED=true

# --- Indeed credentials --------------------------------------------------
INDEED_EMAIL=
INDEED_PASSWORD=
INDEED_ENABLED=true

# --- Behaviour ------------------------------------------------------------
# Auto-submit applications that have no extra screening questions.
# Set to "false" to always pause for manual confirmation instead.
AUTO_SUBMIT=true

# Run browsers headed (visible) or headless. Headed is strongly recommended
# for LinkedIn/Indeed because of bot-detection systems.
HEADLESS=false

# Polling interval (minutes) for the monitor mode
POLL_INTERVAL_MINUTES=30

# Max applications to submit per run, per site (safety cap)
MAX_APPLICATIONS_PER_RUN=15

# Delay range (ms) between actions, to look human. Do not set too low.
MIN_ACTION_DELAY_MS=800
MAX_ACTION_DELAY_MS=2200
